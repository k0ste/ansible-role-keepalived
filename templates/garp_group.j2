{% for kg in k['garp_group'] %}
{{ 'garp_group {' }}
{% if kg['garp_interval'] is defined and kg['garp_interval']
  not in ['', [], '[]', None] %}
{{ '  garp_interval ' ~ kg['garp_interval'] }}
{% endif %}
{% if kg['gna_interval'] is defined and kg['gna_interval']
  not in ['', [], '[]', None] %}
{{ '  gna_interval ' ~ kg['gna_interval'] }}
{% endif %}
{% if kg['interface'] is defined and kg['interface']
  not in ['', [], '[]', None] %}
{{ '  interface ' ~ kg['interface'] }}
{% endif %}
{% if kg['interfaces'] is defined and kg['interfaces']
  not in ['', [], '[]', None] %}
{{ '  interfaces {' }}
{% for kgi in kg['interfaces'] %}
{{ '    ' ~ kgi }}
{% endfor %}
{{ '  }' }}
{% endif %}
{{ '}' }}
{% endfor %}
