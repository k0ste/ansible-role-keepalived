{% if kv['notify_master'] is defined and kv['notify_master']
  not in ['', [], '[]', None] %}
{% for kvn in kv['notify_master'] %}
{% if kvn['exec'] is defined %}
{{ '  notify_master \"' + kvn['exec'] + '\" ' + (kvn['user'] | default('')) +
  ' ' + (kvn['group'] | default('')) }}
{% endif %}
{% endfor %}
{% endif %}
